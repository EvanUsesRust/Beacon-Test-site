{
  "name": "AIMLAPI Image Generator",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "nohup python3 -m http.server 8080 --directory /workspaces/Beacon-Test-site >/tmp/beacon-site.log 2>&1 &",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "index.html"
      ]
    }
  }
}
